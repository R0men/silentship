# ---- Backend (backend/) ----
# MongoDB connection string. DB name: MONGODB_DB, else the URI path, else silentship.
MONGODB_URI=
MONGODB_DB=
ARCHIVE_DIR=./data/archive
REGION=eu
# Legacy endpoint (prod, beta) first, then Microsoft's OneCDN one (onecdn-prod, onecdn-beta)
CHANNELS=prod,beta,onecdn-prod,onecdn-beta
CRON="*/10 * * * *"
FULL_REFRESH_HOURS=6
ALERT_QUIET_MINUTES=20
# Requests per file per run, each on a fresh connection (rollout share precision = 1/SAMPLES)
SAMPLES=8
FETCH_CONCURRENCY=6
# Locales whose office_strings.js are tracked
LOCALES=en-us
# Heap limit (MB) of the sandboxed API-reflection worker; one runs at a time
WORKER_MAX_MB=1024
API_PORT=4000
API_HOST=127.0.0.1
# Proxies allowed to set the client IP (X-Forwarded-For). nginx and Next reach the API over loopback.
TRUST_PROXY=loopback
# /health returns 503 when a channel has not finished a crawl for this long (for UptimeRobot)
HEALTH_STALE_MINUTES=20
# Global cap on confirmation emails per hour (protects the Brevo quota)
MAX_CONFIRMATIONS_PER_HOUR=200

# Public URL of the site (frontend): links in emails and RSS
PUBLIC_URL=http://localhost:3000

# Email via Brevo (transactional API key). Without it, emails are printed to the log.
BREVO_API_KEY=
MAIL_FROM_EMAIL=alerts@example.com
MAIL_FROM_NAME=silentship
# Reply-To of the confirmation and welcome emails
MAIL_REPLY_TO=
SLACK_WEBHOOK_URL=
# Dead-man's switch (healthchecks.io): pinged after every crawl, <url>/fail after a failed one
HEALTHCHECK_URL=

# ---- Backups (deploy/backup.sh) ----
# Where dumps go (default ~/backups); rclone remote for an off-site copy; PRIVATE git remote for data/archive
BACKUP_DIR=
BACKUP_RCLONE_REMOTE=
ARCHIVE_REMOTE=

# ---- Frontend (frontend/) ----
# Where Next.js reaches the API; defaults to http://127.0.0.1:$API_PORT
API_URL=
